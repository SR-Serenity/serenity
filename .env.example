# Local Docker infrastructure defaults.
POSTGRES_USER=serenity
POSTGRES_PASSWORD=serenity
DATABASE_URL="postgresql://serenity:serenity@localhost:5432/serenity?schema=public"
DIRECT_URL="postgresql://serenity:serenity@localhost:5432/serenity?schema=public"
REDIS_URL=redis://localhost:6379

# Shared service config.
NODE_ENV=development
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRES_IN=1d
CORS_ORIGIN=*

# Local service URLs.
GATEWAY_URL=http://localhost:2991
AUTH_SERVICE_URL=http://localhost:2992/api
API_SERVICE_URL=http://localhost:2993/api
CORE_SERVICE_URL=http://localhost:2993/api
REALTIME_SERVICE_URL=http://localhost:2996

# Frontend public URLs.
NEXT_PUBLIC_API_URL=http://localhost:2991
NEXT_PUBLIC_AUTH_URL=http://localhost:2992
NEXT_PUBLIC_CORE_URL=http://localhost:2993
NEXT_PUBLIC_REALTIME_URL=http://localhost:2996

# Gmail / Serenity Mail MVP.
# Use a public HTTPS tunnel to core-service for Google callbacks during local demos.
MAIL_PUBLIC_BASE_URL=https://your-core-service-tunnel.example.com
MAIL_TOKEN_ENCRYPTION_KEY=replace-with-32-byte-base64-key
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://your-core-service-tunnel.example.com/api/mail/google/callback
GOOGLE_PUBSUB_TOPIC=projects/your-project/topics/serenity-gmail-updates
GOOGLE_PUBSUB_AUDIENCE=https://your-core-service-tunnel.example.com/api/mail/webhooks/google/pubsub

# LiveKit video conferencing (self-hosted via docker-compose).
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret
LIVEKIT_WS_URL=ws://localhost:7880
NEXT_PUBLIC_LIVEKIT_WS_URL=ws://localhost:7880
