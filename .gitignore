.nx/polygraph

# Next.js
.next
out

test-output

.agents
.claude
.codex
.cursor
.gemini
# Keep CI workflows tracked, but ignore local AI/agent config under .github
.github/*
!.github/workflows/
.vscode

# Environment variables (NEVER commit!)
.env
.env.local
.env.*.local
.env.production.local
.env.development.local
# Per-service env files (real values) — but keep *.example templates tracked
.env.*
!.env*.example

# Docker
.dockerignore
docker-compose.override.yml
docker-compose.local.yml

# Cloudflare Tunnel credentials (SENSITIVE!)
.cloudflared/
!cloudflare-config.example.yml
!cloudflare-tunnel.yml

# Sensitive files
*.pem
*.key
*.crt
*.cer
credentials.json
private-key.json
certificate.json

# Database files
*.db
*.sqlite
*.sqlite3
dump.rdb

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*

# ESLint cache
.eslintcache

# Build cache
.webpack/
tsconfig.tsbuildinfo
*.tsbuildinfo

