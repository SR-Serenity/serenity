
# ---------- build stage ----------
FROM node:20-alpine AS builder

WORKDIR /app
RUN corepack enable

COPY . .
RUN pnpm install --frozen-lockfile
RUN pnpm prisma generate

ARG SERVICE_NAME
RUN pnpm nx build ${SERVICE_NAME}
# CI=true avoids pnpm's interactive "confirm modules purge" prompt (no TTY here)
RUN CI=true pnpm prune --prod --config.confirmModulesPurge=false \
  && pnpm prisma generate

# ---------- runtime stage ----------
FROM node:20-alpine

WORKDIR /app
RUN apk add --no-cache dumb-init
ENV NODE_ENV=production

ARG SERVICE_NAME
COPY --from=builder /app/dist/apps/${SERVICE_NAME} ./dist
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/prisma ./prisma

RUN addgroup -g 1001 -S nodejs && adduser -S nodejs -u 1001 \
  && chown -R nodejs:nodejs /app
USER nodejs

EXPOSE 3000
ENTRYPOINT ["/usr/sbin/dumb-init", "--"]
CMD ["node", "dist/main.js"]
