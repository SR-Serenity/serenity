# Builds the Python FastAPI ai-service for the single-VM deployment.
# Context must be the repo root (workflow builds with `.`).

FROM python:3.12-slim

WORKDIR /app
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    POETRY_VERSION=1.8.2 \
    POETRY_VIRTUALENVS_CREATE=false

# Build/runtime libs for psycopg (C extension against libpq)
RUN apt-get update \
  && apt-get install -y --no-install-recommends build-essential libpq-dev \
  && rm -rf /var/lib/apt/lists/*

RUN pip install "poetry==${POETRY_VERSION}"

# Install deps first for layer caching (lock generated by Poetry 1.8.2)
COPY apps/ai-service/pyproject.toml apps/ai-service/poetry.lock ./
RUN poetry install --only main --no-root

# App source
COPY apps/ai-service/src ./src

EXPOSE 8001
CMD ["uvicorn", "src.main:app", "--host", "0.0.0.0", "--port", "8001"]
