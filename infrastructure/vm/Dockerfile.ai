# Builds the Python FastAPI ai-service for the single-VM deployment (slim).
# Context must be the repo root (CI builds with `.`).
#
# Multi-stage: compile/install deps with build tools in the builder, then copy
# only the installed packages into a clean runtime that keeps just libpq5.

# ---------- build stage ----------
FROM python:3.12-slim AS builder

ENV PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    POETRY_VERSION=1.8.2 \
    POETRY_VIRTUALENVS_CREATE=false

# Build deps for psycopg's C extension (against libpq)
RUN apt-get update \
  && apt-get install -y --no-install-recommends build-essential libpq-dev \
  && rm -rf /var/lib/apt/lists/*

RUN pip install "poetry==${POETRY_VERSION}"

WORKDIR /app
COPY apps/ai-service/pyproject.toml apps/ai-service/poetry.lock ./
# Installs into the system site-packages (no virtualenv)
RUN poetry install --only main --no-root

# ---------- runtime stage ----------
FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

# Only the runtime shared lib for psycopg — no compilers in the final image
RUN apt-get update \
  && apt-get install -y --no-install-recommends libpq5 \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /app
# Installed packages + console scripts (uvicorn) from the builder
COPY --from=builder /usr/local/lib/python3.12/site-packages /usr/local/lib/python3.12/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin

COPY apps/ai-service/src ./src

EXPOSE 8001
CMD ["uvicorn", "src.main:app", "--host", "0.0.0.0", "--port", "8001"]
