# Development Dockerfile for NestJS Services
# Features: Live reload, debugging, verbose logging
# Usage: docker build --build-arg SERVICE_NAME=core-service -f infrastructure/dev/Dockerfile.nestjs -t serenity-core-service:dev .

FROM node:20-alpine

WORKDIR /app

# Install dependencies (including dev dependencies for live reload tools)
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY prisma ./prisma
RUN corepack enable && pnpm install --frozen-lockfile && pnpm exec prisma generate

ENV PATH="/app/node_modules/.bin:${PATH}"

# Copy source code with node user ownership
COPY --chown=node:node . .

# Ensure node user can run things and write to cache
RUN mkdir -p /app/.nx /app/node_modules/.cache && chown -R node:node /app/.nx /app/node_modules/.cache && chown node:node /app

USER node

EXPOSE 3000

# Development command with live reload
# Uses nx serve for hot module reloading
ARG SERVICE_NAME
ENV SERVICE_NAME=${SERVICE_NAME}
CMD ["sh", "-c", "nx serve ${SERVICE_NAME}"]
