# Development Dockerfile for Next.js Frontend
# Features: Live reload, hot module replacement, debugging
# Usage: docker build -f infrastructure/dev/Dockerfile.nextjs -t serenity-web:dev .

FROM node:20-alpine

WORKDIR /app

# Install dependencies (including dev dependencies for Next.js dev server)
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY prisma ./prisma
RUN corepack enable && pnpm install --frozen-lockfile && pnpm exec prisma generate

ENV PATH="/app/node_modules/.bin:${PATH}"

# Copy source code with node user ownership
COPY --chown=node:node . .

# Ensure node user can run things and write to cache
RUN mkdir -p /app/.nx /app/node_modules/.cache && chown -R node:node /app/.nx /app/node_modules/.cache && chown node:node /app

USER node

EXPOSE 3000

# Development command with hot reload
# Next.js dev server watches files and rebuilds on changes
CMD ["sh", "-c", "pnpm nx run @org/web:dev"]
