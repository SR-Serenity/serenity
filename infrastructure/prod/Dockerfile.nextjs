# Production Dockerfile for Next.js Frontend (Optimized with Standalone Mode)
# Features: Multi-stage build, standalone mode (~200MB image), optimized image size, security hardening
# Usage: docker build -f infrastructure/prod/Dockerfile.nextjs -t serenity-web:latest .
# Note: Requires next.config.js to have output: 'standalone'

# Build stage - compile Next.js app
FROM node:20-alpine AS builder

WORKDIR /app

# Copy package files
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./

# Install all dependencies (including dev for build time)
RUN corepack enable && pnpm install --frozen-lockfile

# Copy source code
COPY . .

# Build Next.js application with optimizations
# Next.js with output: 'standalone' creates .next/standalone with traced dependencies only
RUN pnpm nx build web

# Runtime stage - minimal production image (~200MB vs 758MB)
FROM node:20-alpine

WORKDIR /app

# Install dumb-init for proper signal handling
RUN apk add --no-cache dumb-init

# Set environment for production
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1

# Copy standalone Next.js application (includes only traced dependencies)
# .next/standalone is created by Next.js when output: 'standalone' is configured
COPY --from=builder /app/dist/apps/web/standalone ./

# Copy static assets for client-side
COPY --from=builder /app/dist/apps/web/.next/static ./.next/static

# Copy public assets if they exist
COPY --from=builder /app/public ./public 2>/dev/null || true

# Create non-root user for security
RUN addgroup -g 1001 -S nodejs && adduser -S nodejs -u 1001
USER nodejs

EXPOSE 3000

# Use dumb-init to handle signals properly (graceful shutdown)
ENTRYPOINT ["/usr/bin/dumb-init", "--"]

# Start the production Next.js server
# With standalone mode, server.js is self-contained with only required dependencies
CMD ["node", "server.js"]
