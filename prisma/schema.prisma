generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum ChatConversationType {
  PUBLIC_CHANNEL
  PRIVATE_CHANNEL
  DM
}

enum ChatAttachmentKind {
  FILE
  GIF
}

enum ChatAttachmentUploadStatus {
  PENDING
  COMPLETED
}

enum ContactType {
  EMPLOYEE
  GUEST
  AI_AGENT
}

enum ContactStatus {
  ACTIVE
  INVITED
  ARCHIVED
}

enum CalendarItemType {
  EVENT
  MEETING
  TASK
}

enum CalendarVisibility {
  COMPANY
  PERSONAL
}

enum CalendarTaskStatus {
  TODO
  DONE
}

model Organization {
  id          String            @id @default(cuid())
  name        String
  slug        String            @unique
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  memberships WorkspaceMember[]
  departments  Department[]
  invitations Invitation[]
  chatConversations ChatConversation[]
  chatAttachments    ChatAttachment[]
  contacts           Contact[]
  calendarItems      CalendarItem[]
}

model User {
  id           String            @id @default(cuid())
  email        String            @unique
  displayName  String
  passwordHash String
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  memberships  WorkspaceMember[]
  invitations  Invitation[]      @relation("Inviter")
  chatMemberships ChatConversationMember[]
  chatMessages    ChatMessage[]
  chatReactions   ChatReaction[]
  chatMessageVisibilities ChatMessageVisibility[]
  chatUploads      ChatAttachment[] @relation("ChatAttachmentUploader")
  calendarItems    CalendarItem[] @relation("CalendarItemCreator")
  calendarAttendances CalendarAttendee[]
}

model Department {
  id        String   @id @default(cuid())
  name      String
  orgId     String
  createdAt DateTime @default(now())

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  members      WorkspaceMember[]
  invitations  Invitation[]
  contacts     Contact[]

  @@index([orgId])
}

model Contact {
  id           String        @id @default(cuid())
  orgId        String
  type         ContactType
  status       ContactStatus @default(ACTIVE)
  displayName  String
  email        String?
  phone        String?
  company      String?
  title        String?
  departmentId String?
  notes        String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  department   Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  @@index([orgId])
  @@index([orgId, type])
  @@index([departmentId])
  @@index([email])
}

model CalendarItem {
  id                  String              @id @default(cuid())
  orgId               String
  createdById         String
  type                CalendarItemType
  visibility          CalendarVisibility  @default(PERSONAL)
  title               String
  descriptionMarkdown String?
  location            String?
  startAt             DateTime?
  endAt               DateTime?
  allDay              Boolean             @default(false)
  taskStatus          CalendarTaskStatus?
  dueDate             DateTime?
  deletedAt           DateTime?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  creator      User         @relation("CalendarItemCreator", fields: [createdById], references: [id], onDelete: Cascade)
  attendees    CalendarAttendee[]

  @@index([orgId, startAt])
  @@index([orgId, dueDate])
  @@index([orgId, visibility])
  @@index([createdById])
  @@index([deletedAt])
}

model CalendarAttendee {
  id        String   @id @default(cuid())
  itemId    String
  userId    String
  createdAt DateTime @default(now())

  item CalendarItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([itemId, userId])
  @@index([userId])
}

model WorkspaceMember {
  id            String        @id @default(cuid())
  userId        String
  orgId         String
  role          WorkspaceRole @default(MEMBER)
  departmentId  String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  department   Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  @@unique([userId, orgId])
  @@index([orgId])
  @@index([userId])
  @@index([departmentId])
}

model Invitation {
  id           String           @id @default(cuid())
  email        String
  orgId        String
  role         WorkspaceRole    @default(MEMBER)
  departmentId String?
  token        String           @unique
  expiresAt    DateTime
  status       InvitationStatus @default(PENDING)
  inviterId    String
  createdAt    DateTime         @default(now())

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  inviter      User        @relation("Inviter", fields: [inviterId], references: [id])
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  @@index([orgId])
  @@index([token])
  @@index([email, orgId])
}

model ChatConversation {
  id        String               @id @default(cuid())
  orgId     String
  type      ChatConversationType
  name      String?
  slug      String?
  dmKey     String?
  createdById String
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  members      ChatConversationMember[]
  messages     ChatMessage[]
  attachments  ChatAttachment[]

  @@unique([orgId, slug])
  @@unique([orgId, dmKey])
  @@index([orgId, type])
  @@index([orgId, updatedAt, id])
}

model ChatConversationMember {
  id             String   @id @default(cuid())
  conversationId String
  userId         String
  joinedAt       DateTime @default(now())

  conversation ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
}

model ChatMessage {
  id             String   @id @default(cuid())
  conversationId String
  authorId       String
  parentId       String?
  replyToId      String?
  content        String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  editedAt       DateTime?
  unsentAt       DateTime?

  conversation ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  author       User             @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent       ChatMessage?     @relation("ChatThread", fields: [parentId], references: [id], onDelete: Cascade)
  replies      ChatMessage[]    @relation("ChatThread")
  replyTo      ChatMessage?     @relation("ChatInlineReply", fields: [replyToId], references: [id], onDelete: SetNull)
  inlineReplies ChatMessage[]   @relation("ChatInlineReply")
  reactions    ChatReaction[]
  attachments  ChatAttachment[]
  visibilities ChatMessageVisibility[]

  @@index([conversationId, createdAt])
  @@index([parentId, createdAt])
  @@index([replyToId])
  @@index([conversationId, parentId, createdAt, id])
}

model ChatMessageVisibility {
  id        String   @id @default(cuid())
  messageId String
  userId    String
  deletedAt DateTime @default(now())

  message ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([userId, deletedAt])
}

model ChatReaction {
  id        String   @id @default(cuid())
  messageId String
  userId    String
  emoji     String
  createdAt DateTime @default(now())

  message ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
  @@index([userId])
  @@index([messageId, createdAt])
}

model ChatAttachment {
  id             String                     @id @default(cuid())
  messageId      String?
  orgId          String
  conversationId String
  uploadedById   String
  kind           ChatAttachmentKind
  uploadStatus   ChatAttachmentUploadStatus @default(PENDING)
  publicId       String
  url            String?
  name           String
  mimeType       String?
  size           Int?
  provider       String?
  metadata       Json?
  createdAt      DateTime                   @default(now())

  organization Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  conversation ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  uploadedBy   User             @relation("ChatAttachmentUploader", fields: [uploadedById], references: [id], onDelete: Cascade)
  message      ChatMessage?     @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([publicId])
  @@index([messageId])
  @@index([conversationId, uploadedById, uploadStatus])
}
