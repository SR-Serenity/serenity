{
  "name": "@org/web",
  "projectType": "application",
  "sourceRoot": "apps/web/src",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "inputs": ["default", "^production"],
      "options": {
        "cwd": "apps/web",
        "command": "pnpm exec next build ."
      },
      "outputs": ["{workspaceRoot}/apps/web/.next/**/*"]
    },
    "test": {
      "executor": "nx:run-commands",
      "inputs": ["default", "^production"],
      "options": {
        "cwd": "apps/web",
        "command": "pnpm exec jest --passWithNoTests"
      },
      "dependsOn": ["^build"]
    },
    "dev": {
      "executor": "nx:run-commands",
      "continuous": true,
      "options": {
        "cwd": "apps/web",
        "command": "pnpm exec next dev -p 9999"
      }
    }
  }
}
