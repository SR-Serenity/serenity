{
  "name": "@org/core-service",
  "version": "0.0.1",
  "private": true,
  "nx": {
    "name": "core-service",
    "targets": {
      "build": {
        "executor": "nx:run-commands",
        "options": {
          "command": "node ../../node_modules/webpack-cli/bin/cli.js build",
          "args": [
            "--node-env=production"
          ],
          "cwd": "apps/core-service"
        },
        "configurations": {
          "development": {
            "args": [
              "--node-env=development"
            ]
          }
        }
      },
      "prune-lockfile": {
        "dependsOn": [
          "build"
        ],
        "cache": true,
        "executor": "@nx/js:prune-lockfile",
        "outputs": [
          "{workspaceRoot}/apps/core-service/dist/package.json",
          "{workspaceRoot}/apps/core-service/dist/package-lock.json"
        ],
        "options": {
          "buildTarget": "build"
        }
      },
      "copy-workspace-modules": {
        "dependsOn": [
          "build"
        ],
        "cache": true,
        "outputs": [
          "{workspaceRoot}/apps/core-service/dist/workspace_modules"
        ],
        "executor": "@nx/js:copy-workspace-modules",
        "options": {
          "buildTarget": "build"
        }
      },
      "prune": {
        "dependsOn": [
          "prune-lockfile",
          "copy-workspace-modules"
        ],
        "executor": "nx:noop"
      },
      "serve": {
        "continuous": true,
        "executor": "@nx/js:node",
        "defaultConfiguration": "development",
        "options": {
          "buildTarget": "core-service:build",
          "runBuildTargetDependencies": false,
          "inspect": false
        },
        "configurations": {
          "development": {
            "buildTarget": "core-service:build:development"
          },
          "production": {
            "buildTarget": "core-service:build:production"
          }
        }
      },
      "test": {
        "inputs": [
          "default",
          "^production",
          "{workspaceRoot}/jest.preset.js"
        ],
        "options": {
          "passWithNoTests": true
        }
      }
    }
  },
  "dependencies": {
    "@google-cloud/storage": "^7.19.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "bullmq": "^5.77.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "googleapis": "^172.0.0",
    "ioredis": "^5.10.1",
    "livekit-server-sdk": "^2.15.3",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.0.0",
    "jest": "^30.3.0",
    "webpack-cli": "^5.1.4"
  }
}
