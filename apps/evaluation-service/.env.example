PROJECT_NAME=Serenity Evaluation Service
VERSION=0.1.0

# PostgreSQL — same DB as core-service (separate schema via table prefix)
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/serenity

# OpenAI — used as the DeepEval judge model
OPENAI_API_KEY=sk-...

# AI service endpoint (the system under test)
AI_SERVICE_URL=http://localhost:8000

# Internal token for ai-service /api/internal routes (optional, uses /api/ai/chat if not set)
INTERNAL_API_TOKEN=dev-internal-token

ALLOWED_ORIGINS=["http://localhost:9998"]

# Port 8002 (ai-service uses 8001)
